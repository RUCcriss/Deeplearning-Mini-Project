    "callbacks = [keras.callbacks.EarlyStopping(monitor='val_loss', patience=6, restore_best_weights=True)] \n",
    "history = mpnn.fit(train_dataset, validation_data=valid_dataset, epochs=40, verbose=2, callbacks=callbacks)\n",
    "eval_train_dataset = mpnn_dataset(x_train, y_train, shuffle=False)\n",
    "train_probabilities = mpnn.predict(eval_train_dataset, verbose=0)\n",
    "valid_probabilities = mpnn.predict(valid_dataset, verbose=0)\n",
    "probabilities = mpnn.predict(test_dataset, verbose=0)\n",
    "\n",
    "def diagnostic_metrics(labels, scores, thresholds=0.5):\n",
    "    labels = np.asarray(labels, dtype='float32')\n",
    "    scores = np.asarray(scores, dtype='float32')\n",
    "    threshold_array = np.broadcast_to(thresholds, scores.shape[1])\n",
    "    predictions = (scores >= threshold_array).astype('float32')\n",
    "    true_positive = np.sum(labels * predictions)\n",
    "    false_positive = np.sum((1.0 - labels) * predictions)\n",
    "    false_negative = np.sum(labels * (1.0 - predictions))\n",
    "    precision = true_positive / max(true_positive + false_positive, 1.0)\n",
    "    recall = true_positive / max(true_positive + false_negative, 1.0)\n",
    "    f1 = 2.0 * precision * recall / max(precision + recall, 1e-12)\n",
    "    auc = keras.metrics.AUC(name='diagnostic_auc')\n",
    "    auc.update_state(labels.ravel(), scores.ravel())\n",
    "    return float(auc.result()), float(precision), float(recall), float(f1), int(predictions.sum())\n",
    "\n",
    "print('\\nOverfitting diagnostic (threshold = 0.5)')\n",
    "for name, labels, scores in [\n",
    "    ('train', y_train, train_probabilities),\n",
    "    ('valid', y_valid, valid_probabilities),\n",
    "    ('test', y_test, probabilities),\n",
    "]:\n",
    "    auc, precision, recall, f1, positive_count = diagnostic_metrics(labels, scores)\n",
    "    print(f'  {name:5s}: AUC={auc:.4f}, precision={precision:.4f}, recall={recall:.4f}, F1={f1:.4f}, predicted positives={positive_count:,}')\n"
   ]
