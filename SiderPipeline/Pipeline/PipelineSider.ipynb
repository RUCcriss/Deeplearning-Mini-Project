    "def calculate_metrics(labels, scores, threshold=0.5):\n",
    "    predictions = (scores >= threshold).astype('float32')\n",
    "    per_effect_roc_auc = []\n",
    "    per_effect_pr_auc = []\n",
    "    for effect_index in range(labels.shape[1]):\n",
    "        effect_labels = labels[:, effect_index]\n",
    "        if np.unique(effect_labels).size < 2:\n",
    "            continue\n",
    "        per_effect_roc_auc.append(roc_auc_score(effect_labels, scores[:, effect_index]))\n",
    "        per_effect_pr_auc.append(average_precision_score(effect_labels, scores[:, effect_index]))\n",
    "\n",
    "    return {\n",
    "        'Micro ROC-AUC': roc_auc_score(labels, scores, average='micro'),\n",
    "        'Macro ROC-AUC': np.mean(per_effect_roc_auc),\n",
    "        'Micro PR-AUC': average_precision_score(labels, scores, average='micro'),\n",
    "        'Macro PR-AUC': np.mean(per_effect_pr_auc),\n",
    "        'Precision': precision_score(labels.ravel(), predictions.ravel(), zero_division=0),\n",
    "        'Recall': recall_score(labels.ravel(), predictions.ravel(), zero_division=0),\n",
    "        'F1-score': f1_score(labels.ravel(), predictions.ravel(), zero_division=0),\n",
    "    }\n",
    "\n",
    "metric_descriptions = {\n",
    "    'Micro ROC-AUC': 'Ability to distinguish positive from negative labels across all predictions',\n",
    "    'Macro ROC-AUC': 'Ability to distinguish between molecules for each individual side effect',\n",
    "    'Micro PR-AUC': 'Performance on positive predictions across all side effects',\n",
    "    'Macro PR-AUC': 'Performance on positive predictions for each individual side effect',\n",
    "    'Precision': 'How many of the predicted side effects are correct',\n",
    "    'Recall': 'How many of the actual side effects are identified',\n",
    "    'F1-score': 'Balance between precision and recall',\n",
    "}\n",
    "split_predictions = {\n",
    "    'Train': (y_train, train_probabilities),\n",
    "    'Validation': (y_valid, valid_probabilities),\n",
    "    'Test': (y_test, probabilities),\n",
    "}\n",
    "split_metrics = {name: calculate_metrics(labels, scores) for name, (labels, scores) in split_predictions.items()}\n",
    "evaluation_metrics = pd.DataFrame([\n",
    "    (metric, description, split_metrics['Train'][metric], split_metrics['Validation'][metric], split_metrics['Test'][metric])\n",
    "    for metric, description in metric_descriptions.items()\n",
    "], columns=['Metric', 'What it tells us', 'Train', 'Validation', 'Test'])\n",
    "for split in ['Train', 'Validation', 'Test']:\n",
    "    evaluation_metrics[split] = evaluation_metrics[split].map(lambda value: f'{value:.4f}')\n",
    "evaluation_metrics\n"
   ]
  },
