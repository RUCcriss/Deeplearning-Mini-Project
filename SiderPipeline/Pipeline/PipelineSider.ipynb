    "# Function for preparing a batch of data for training.\n",
    "def prepare_batch(x_batch, y_batch):\n",
    "    atom_features, bond_features, pair_indices = x_batch # X_batch contains graph data (atom features, bond features, and pair indices) for a batch of molecules. \n",
    "    num_atoms = atom_features.row_lengths() # Counts the number of atoms in each molecule in the batch.\n",
    "    num_bonds = bond_features.row_lengths() # Counts the number of bonds in each molecule in the batch. \n",
    "    molecule_indices = tf.range(tf.shape(num_atoms)[0]) # Assigns each molecule of the batch a unique ID.\n",
    "    molecule_indicator = tf.repeat(molecule_indices, num_atoms) # Repeat each molecule ID for all its atoms to indicate which molecule each atom belongs to.\n",
    "    gather_indices = tf.repeat(molecule_indices[:-1], num_bonds[1:]) #  # Create indices for looking up the correct atom offset for each bond.\n",
    "    increment = tf.cumsum(num_atoms[:-1]) # Calculate cumulative atom offsets for molecules after the first. \n",
    "    increment = tf.pad(tf.gather(increment, gather_indices), [(num_bonds[0], 0)]) # Expand offsets so there is one offset per bond, and pad the first molecule with zeros since it has no offset.\n",
    "    pair_indices = pair_indices.merge_dims(0, 1).to_tensor() + increment[:, tf.newaxis] # Adjust the pair indices to match the merged graph. \n",
    "    atom_features = atom_features.merge_dims(0, 1).to_tensor() # Merge atom features into a single tensor for the batch.\n",
    "    bond_features = bond_features.merge_dims(0, 1).to_tensor() # Merge bond features into a single tensor for the batch.\n",
    "    return (atom_features, bond_features, tf.cast(pair_indices, tf.int32), molecule_indicator), y_batch # Return the prepared batch of merged graph and labels. \n",
    "\n",
    "# Function for creating a TensorFlow dataset for MPNN training. A default batch size of 32 molecules is used.\n",
    "def mpnn_dataset(x, y, batch_size=32, shuffle=False):\n",
    "    dataset = tf.data.Dataset.from_tensor_slices((x, y)) # Creates a dataset from the input graph data and labels.\n",
    "    if shuffle:\n",
    "        dataset = dataset.shuffle(min(len(y), 1024), seed=42) # If shuffle is True, randomly shuffle the dataset\n",
    "    # Returns a dataset that is batched and preprocessed by the prepare_batch function. \n",
    "    # Prefetching prepares the next batch of data while the current batch is being processed, improving training efficiency.\n",
    "    return dataset.batch(batch_size).map(prepare_batch, num_parallel_calls=tf.data.AUTOTUNE).prefetch(tf.data.AUTOTUNE)\n",
    "\n",
    "# EdgeNetwork class responsible for message passing between connected atoms with weights.\n",
    "class EdgeNetwork(layers.Layer):\n",
    "    def build(self, input_shape):\n",
    "        self.atom_dim, self.bond_dim = input_shape[0][-1], input_shape[1][-1]\n",
    "        self.kernel = self.add_weight(shape=(self.bond_dim, self.atom_dim * self.atom_dim), initializer='glorot_uniform') # \n",
    "        self.bias = self.add_weight(shape=(self.atom_dim * self.atom_dim,), initializer='zeros')\n",
    "    def call(self, inputs):\n",
    "        atom_features, bond_features, pair_indices = inputs\n",
    "        transformed_bonds = tf.reshape(tf.matmul(bond_features, self.kernel) + self.bias, (-1, self.atom_dim, self.atom_dim))\n",
    "        neighbors = tf.expand_dims(tf.gather(atom_features, pair_indices[:, 1]), -1)\n",
    "        messages = tf.squeeze(tf.matmul(transformed_bonds, neighbors), -1)\n",
    "        return tf.math.unsorted_segment_sum(messages, pair_indices[:, 0], tf.shape(atom_features)[0])\n",
    "\n",
    "# MessagePassing class responsible for updating atom representations based on messages received from neighboring atoms.\n",
    "class MessagePassing(layers.Layer):\n",
    "    def __init__(self, units=64, steps=4, **kwargs): # Units: Hidden node representation dimension. Steps: each atom of a molecule receives messages from neighbours up to 4 bonds away.\n",
    "        super().__init__(**kwargs); self.units, self.steps = units, steps\n",
    "    def build(self, input_shape):\n",
    "        atom_dim = input_shape[0][-1]\n",
    "        self.padding = max(0, self.units - atom_dim)\n",
    "        self.edge_network = EdgeNetwork()\n",
    "        self.gru = layers.GRUCell(atom_dim + self.padding) # GRUCell updates the atom features based on the messages received from neighboring atoms.\n",
    "    def call(self, inputs):\n",
    "        atom_features, bond_features, pair_indices = inputs\n",
    "        state = tf.pad(atom_features, [(0, 0), (0, self.padding)])\n",
    "        for _ in range(self.steps):\n",
    "            messages = self.edge_network([state, bond_features, pair_indices])\n",
    "            state, _ = self.gru(messages, [state])\n",
    "        return state\n",
    "\n",
    "# Readout class responsible for creating molecule representations by mean pooling atom states and applying projection to the pooled vector through a dense layer.\n",
    "class Readout(layers.Layer):\n",
    "    def __init__(self, units, **kwargs):\n",
    "        super().__init__(**kwargs); self.projection = layers.Dense(units, activation='relu')\n",
    "    def call(self, inputs):\n",
    "        atom_states, molecule_indicator = inputs\n",
    "        count = tf.reduce_max(molecule_indicator) + 1\n",
    "        pooled = tf.math.unsorted_segment_mean(atom_states, molecule_indicator, count)\n",
    "        return self.projection(pooled) # Returns a vector of the learned molecule embeddings.\n",
    "\n",
    "# Function for creating the complete MPNN model. It takes in the dimensions of atom features, bond features, and target labels, as well as optional parameters for message passing and dense layers.\n",
    "def MPNNModel(atom_dim, bond_dim, target_dim, message_units=64, message_steps=4, dense_units=256):\n",
    "    atom_features = layers.Input((atom_dim,), dtype='float32', name='atom_features')\n",
    "    bond_features = layers.Input((bond_dim,), dtype='float32', name='bond_features')\n",
    "    pair_indices = layers.Input((2,), dtype='int32', name='pair_indices')\n",
    "    molecule_indicator = layers.Input((), dtype='int32', name='molecule_indicator')\n",
    "    states = MessagePassing(message_units, message_steps)([atom_features, bond_features, pair_indices])\n",
    "    embedding = Readout(message_units)([states, molecule_indicator])\n",
    "    output = layers.Dense(dense_units, activation='relu')(embedding)\n",
    "    output = layers.Dense(target_dim, activation='sigmoid', name='side_effect_probabilities')(output)\n",
    "    return keras.Model([atom_features, bond_features, pair_indices, molecule_indicator], output) # Returns the complete MPNN model\n",
    "\n",
    "x_train, y_train = graph_data['train'], label_data['train']\n",
    "x_valid, y_valid = graph_data['valid'], label_data['valid']\n",
    "x_test, y_test = graph_data['test'], label_data['test']\n",
    "train_dataset = mpnn_dataset(x_train, y_train, shuffle=True)\n",
    "valid_dataset = mpnn_dataset(x_valid, y_valid)\n",
    "test_dataset = mpnn_dataset(x_test, y_test)\n",
    "mpnn = MPNNModel(x_train[0][0][0].shape[0], x_train[1][0][0].shape[0], len(target_names))\n",
    "mpnn.compile(optimizer=keras.optimizers.Adam(5e-4), loss='binary_crossentropy', metrics=[keras.metrics.AUC(name='micro_auc', multi_label=False)])\n",
    "mpnn.summary()"
   ]
  },
