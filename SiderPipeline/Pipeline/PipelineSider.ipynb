    "# Featurizer class for encoding atom or bonds into fixed-length vectors. \n",
    "# Each feature is one-hot encoded, and the resulting vectors are concatenated to form a single vector for each atom or bond.\n",
    "class Featurizer:\n",
    "    def __init__(self, allowable_sets):\n",
    "        self.dim = 0\n",
    "        self.features_mapping = {}\n",
    "        for name, values in allowable_sets.items():\n",
    "            values = sorted(values, key=str)\n",
    "            self.features_mapping[name] = dict(zip(values, range(self.dim, self.dim + len(values))))\n",
    "            self.dim += len(values)\n",
    "\n",
    "    # One-hot encoding of features into a fixed-length vector for each atom or bond \n",
    "    def encode(self, value):\n",
    "        output = np.zeros(self.dim, dtype='float32') # First, all features in an atom or bond is set to 0.\n",
    "        for name, mapping in self.features_mapping.items():\n",
    "            feature = getattr(self, name)(value)\n",
    "            if feature in mapping: # If a feature is present in the mapping, it is set to 1.0 in the output vector.\n",
    "                output[mapping[feature]] = 1.0\n",
    "        return output\n",
    "\n",
    "# AtomFeaturizer class inherits the mapping from Featurizer. It retrieves atom features and encodes them into a fixed-length vector. The features include atom symbol, total valence, number of hydrogens, and hybridization state.\n",
    "class AtomFeaturizer(Featurizer):\n",
    "    def symbol(self, atom): return atom.GetSymbol() # Retrieves atom symbol from RDKit's atom object.\n",
    "    def n_valence(self, atom): return atom.GetTotalValence() # Retrieves total valence of the atom from RDKit's atom object.\n",
    "    def n_hydrogens(self, atom): return atom.GetTotalNumHs() # Retrieves total number of hydrogens attached to the atom from RDKit's atom object.\n",
    "    def hybridization(self, atom): return atom.GetHybridization().name.lower() # Retrieves hybridization state of the atom from RDKit's atom object.\n",
    "\n",
    "# BondFeaturizer class inherits the mapping from Featurizer. It retrieves bond features and encodes them into a fixed-length vector. The features include bond type and whether the bond is conjugated. \n",
    "class BondFeaturizer(Featurizer):\n",
    "    def __init__(self, allowable_sets):\n",
    "        super().__init__(allowable_sets)\n",
    "        self.dim += 1 # Adds an extra dimension to the feature vector to account for a case where a bond is not present.\n",
    "\n",
    "    def encode(self, bond): # Encodes bond features. If a bond is not present, it returns a vector of zeros with the last vector position set to 1.0, indicating the absence of a bond.\n",
    "        if bond is None:\n",
    "            output = np.zeros(self.dim, dtype='float32')\n",
    "            output[-1] = 1.0\n",
    "            return output\n",
    "        return super().encode(bond) # If a bond is present, it calls the parent class (Featurizer) encode method to encode the bond features.\n",
    "\n",
    "    def bond_type(self, bond): return bond.GetBondType().name.lower() # Retrieves the object's bond type, either (single, double, triple, or aromatic)\n",
    "    def conjugated(self, bond): return bond.GetIsConjugated() # Retrieves a Boolean (true, false) for if the bond is conjugated or not.\n",
    "\n",
    "# atom_featurizer and bond_featurizer are instances of AtomFeaturizer and BondFeaturizer. They are initialized with allowable sets of features for atoms and bonds. \n",
    "# The allowable sets define the possible values for each feature, which is used for one-hot encoding.\n",
    "atom_featurizer = AtomFeaturizer({\n",
    "    'symbol': {'B', 'Br', 'C', 'Ca', 'Cl', 'F', 'H', 'I', 'N', 'Na', 'O', 'P', 'S'},\n",
    "    'n_valence': {0, 1, 2, 3, 4, 5, 6},\n",
    "    'n_hydrogens': {0, 1, 2, 3, 4},\n",
    "    'hybridization': {'s', 'sp', 'sp2', 'sp3'},\n",
    "})\n",
    "bond_featurizer = BondFeaturizer({\n",
    "    'bond_type': {'single', 'double', 'triple', 'aromatic'},\n",
    "    'conjugated': {True, False},\n",
    "})\n",
    "\n",
    "# Function for converting a SMILES string into an RDKit molecule object.\n",
    "def molecule_from_smiles(smiles):\n",
    "    return Chem.MolFromSmiles(str(smiles))\n",
    "\n",
    "# Function for converting an RDKit molecule object into a graph representation. \n",
    "def graph_from_molecule(molecule):\n",
    "    atom_features, bond_features, pair_indices = [], [], [] # Empty list to store atom features, bond features, and pair indices (atom connections).\n",
    "    # Loops through all atoms in the molecule and retrieves the features for each atom.\n",
    "    for atom in molecule.GetAtoms(): \n",
    "        atom_features.append(atom_featurizer.encode(atom))\n",
    "        pair_indices.append([atom.GetIdx(), atom.GetIdx()])\n",
    "        bond_features.append(bond_featurizer.encode(None))\n",
    "        # Loops through all neighboring atoms of the current atom to retrieve further features.\n",
    "        for neighbor in atom.GetNeighbors(): \n",
    "            bond = molecule.GetBondBetweenAtoms(atom.GetIdx(), neighbor.GetIdx())\n",
    "            pair_indices.append([atom.GetIdx(), neighbor.GetIdx()])\n",
    "            bond_features.append(bond_featurizer.encode(bond))\n",
    "    # Returns three numpy arrays to represent the molecule as graph representation\n",
    "    return np.asarray(atom_features), np.asarray(bond_features), np.asarray(pair_indices) \n",
    "\n",
    "# Function for converting a list of SMILES-strings into graph representations. \n",
    "def graphs_from_smiles(smiles_list):\n",
    "    atom_list, bond_list, pair_list, keep = [], [], [], []\n",
    "    # Loops through all SMILES strings in the list and converts them into graph representations.\n",
    "    for index, smiles in enumerate(smiles_list):\n",
    "        molecule = molecule_from_smiles(smiles) # Converts the SMILES string into an RDKit molecule object.\n",
    "        if molecule is None or molecule.GetNumAtoms() == 0: # Skip molecules that cannot be converted.\n",
    "            continue\n",
    "        atom_features, bond_features, pair_indices = graph_from_molecule(molecule)\n",
    "        # Save the atom features into their lists\n",
    "        atom_list.append(atom_features)\n",
    "        bond_list.append(bond_features)\n",
    "        pair_list.append(pair_indices)\n",
    "        keep.append(index)\n",
    "    # Returns the feature lists as ragged constant tensors.\n",
    "    return (tf.ragged.constant(atom_list, dtype=tf.float32),\n",
    "            tf.ragged.constant(bond_list, dtype=tf.float32),\n",
    "            tf.ragged.constant(pair_list, dtype=tf.int64), keep)\n",
    "\n",
    "# Split the dataset into training, validation, and test sets. \n",
    "permuted = np.random.permutation(len(df)) # Randomizes row indices of the dataset.\n",
    "train_end, valid_end = int(len(df) * 0.8), int(len(df) * 0.9) # 80% for training, 10% for validation, and 10% for testing.\n",
    "splits = {'train': permuted[:train_end], 'valid': permuted[train_end:valid_end], 'test': permuted[valid_end:]} # Create splits\n",
    "graph_data, label_data = {}, {} # Initialize dictionaries to store graph representations and labels for each split.\n",
    "# Loop through each of the three splits.\n",
    "for name, indices in splits.items():\n",
    "    graphs = graphs_from_smiles(df.iloc[indices]['smiles'].to_numpy()) # Convert the SMILES strings into graph representations. \n",
    "    kept_indices = indices[graphs[3]] \n",
    "    graph_data[name] = graphs[:3] # Store the graph representations for the current split.\n",
    "    label_data[name] = targets.iloc[kept_indices].to_numpy(dtype='float32') # Store the labels for the current split.\n",
    "    splits[name] = kept_indices \n",
    "    print(f'{name}: {len(kept_indices):,} molecules')"
   ]
  },
